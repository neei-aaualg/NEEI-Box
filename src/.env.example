# Base de Dados (PostgreSQL no Coolify)
DATABASE_URL="postgresql://user:password@localhost:5432/neei_box?schema=public"

# Diretório de Armazenamento de Materiais (Volume Persistente)
UPLOAD_DIR="uploads"

# Limites de Armazenamento (em MB por ficheiro e em GB no total do volume)
MAX_FILE_SIZE_MB="50"
MAX_STORAGE_LIMIT_GB="8"

# Envio de Emails / Códigos OTP
# Opção 1: Microsoft 365 SMTP (Configuração recomendada, idêntica ao siteneei)
# Exemplo para Microsoft 365:
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT=587
# SMTP_USER="neei@aaualg.pt"
# SMTP_PASS="tua_password"
# SMTP_FROM="NEEI – AAUAlg <neei@aaualg.pt>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NEEI – AAUAlg <neei@aaualg.pt>"

# Opção 2: Resend API (Opcional - envio transacional direto)
# RESEND_API_KEY=
# RESEND_FROM="NEEI-Box <no-reply@neei.online>"


# Lista de emails com permissões de administrador (separados por vírgula)
ADMIN_EMAILS="a79994@ualg.pt"
